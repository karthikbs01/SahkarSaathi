# Base URL of the SahkarSaathi backend API (see src/services/api.js)
VITE_API_BASE_URL=http://localhost:8000

# When true, the frontend uses local mock responses (src/data/mockResponses.js)
# instead of calling the backend. Useful for frontend development/demos when
# the backend isn't running. Set to false to always call VITE_API_BASE_URL.
VITE_USE_MOCK_API=true
